{
	"name": "dream-rate",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"svelte": "^5.57.3",
		"svelte-check": "^4.0.0",
		"typescript": "^6.0.0",
		"vite": "^8.3.8",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.56.0",
		"svelecte": "^5.3.0"
	}
}
